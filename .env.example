# Vatly Laravel — environment variables
#
# Copy the relevant entries into your application's .env. Only VATLY_KEY and
# VATLY_WEBHOOK_SECRET are required; the rest have sensible defaults (see
# config/vatly.php and docs/configuration.md).

# Your Vatly API key. Testmode is inferred from the prefix (test_ vs live_),
# so no separate testmode flag is needed.
VATLY_KEY=test_xxxxxxxxxxxx

# The signing secret used to verify inbound webhook signatures. Set the same
# value in your Vatly dashboard webhook configuration.
VATLY_WEBHOOK_SECRET=your-webhook-secret

# Default redirect URLs for hosted checkout (optional — can also be passed
# per-checkout at call time).
VATLY_REDIRECT_URL_SUCCESS=https://your-app.test/checkout/success
VATLY_REDIRECT_URL_CANCELED=https://your-app.test/checkout/canceled

# Advanced / optional overrides (defaults shown).
# VATLY_API_URL=https://api.vatly.com
# VATLY_API_VERSION=v1
# VATLY_BILLABLE_MODEL="App\Models\User"
